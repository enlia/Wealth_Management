# ═══════════════════════════════════════════════════════════════
# 环境变量模板
#
# 用法：
#   1. 复制本文件为 .env（同目录）
#   2. 填入真实值
#   3. .env 已被 .gitignore 排除，不会误提交
#
# 代码读取方式：src/factor_lab/config.py 顶部
# ═══════════════════════════════════════════════════════════════


# ── Tushare Pro（数据补全的唯一凭证）─────────────────────────
# 获取方式：https://tushare.pro/register
# 权限说明：docs/data/04_Tushare积分机制详解.md
# 2000 积分可覆盖本项目全部所需接口（adj_factor / index_member_all /
# stock_basic / daily_basic / fina_indicator）
TUSHARE_TOKEN=在这里填你的token


# ── 项目根目录（一般不需要设置）──────────────────────────────
# 留空则自动从 src/factor_lab/config.py 逐级上溯查找含 .git 的目录。
# 手动指定适用于：项目被作为子目录嵌入其他仓库的场景。
# WM_ROOT=C:/Documentation/Wealth_Management


# ── 本机通达信安装路径（数据源头，用于核对 SQLite 正确性）─────
# 留空则自动探测常见安装位置。
# 用途：research/scripts/audit_data_quality.py 会直接读vipdoc 原始文件，
#      与 SQLite 中的数据做交叉验证 —— 这是发现未复权污染的关键手段。
# TDX_VIPDOC=C:/SoftWare/TONGDAXIN/Body/vipdoc
