# ═══════════════════════════════════════════════════════════════
#Wealth_Management .gitignore
#
# 原则：
#   1. 能重建的大文件 → 不入库（数据库、产出、第三方代码）
#   2. 研究结论与报告 → 必须入库（results/ 下的 HTML/CSV 是核心资产）
#   3. 任何密钥凭证 → 永不入库
# ═══════════════════════════════════════════════════════════════

# ── 数据层：数据库与行情文件（1.9G，可从通达信重建）──────────
# ⚠️ 必须写成 `/data/`（前导斜杠锚定到仓库根），不能写 `data/`
#    否则会连带忽略 src/factor_lab/data/ —— 那是包自己的数据访问层
#    （sqlite_source.py / universe.py），漏入库会让全新克隆必然崩溃：
#      ModuleNotFoundError: No module named 'factor_lab.data'
#    本地能跑是因为工作区残留文件，CI 与他人克隆才暴露。
#    同理 reference/ runtime/ 也已锚定（⚠️ 曾有"注释称已锚定、正文没锚定"
#    的言行不一行，2026-10-07 整改为真正锚定并以 check-ignore 探针留证）。
/data/
/*.db
/*.db-wal
/*.db-shm
*.sqlite
*.sqlite3
/raw/

# ── 列式/二进制数据文件 ─────────────────────────────────────
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.pt
*.pth

# ── 运行时产出（可由脚本重新生成，含 68M 中间结果）────────────
# ⚠️ 目录重组：原 09_研究项目/factor_lab/out/ → runtime/
# ⚠️ 全部目录规则一律前导斜杠锚定到仓库根（P20 教训）：
#    不锚定会吞掉代码层里的同名目录。
/runtime/
/out/
/output/
/reports/generated/

# ── 第三方开源项目（935M，只读参考）────────────────────────
# ⚠️ 目录重组：原 06_开源项目/ → reference/
/reference/

# ── 研究产出：只忽略中间 CSV，保留报告与结论 ────────────────
# ⚠️ 原规则是results/（整目录忽略），导致 05_实证研究 下的
#    黄金分割实证研究报告.html / PDF 从未入库 —— 那是核心结论，不能丢
results/**/*.log
results/**/*_raw.txt
*_result.csv
*_detail.csv
cross_validation.csv
cand_fail.csv
cand_success.csv
fib_tdx_cases.csv
# 说明：cases_dated.csv / 因子多前瞻期IC_全市场.csv / 选股能力_全市场实测.csv
#      是研究结论本身，刻意入库，便于他人复核数字

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── 虚拟环境（uv）──────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv / 工具缓存 ─────────────────────────────────────────
.uv/
uv-cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# ── IDE / 系统 ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 密钥与凭证（永不入库）───────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
token.txt
*tushare_token*

# ── 会话与工具工作区（2026-10-07 新增，全部锚定）────────────
# .worktree/  git worktree 统一放这里（项目 AGENTS.md 一.6）
# .planning/  会话台账/报告（不入库；结论蒸馏进 docs/ 或 standards 才入库）
# .workbuddy/ 弃用工具的记忆目录兜底（防止任何工具再写入后混进版本库）
/.worktree/
/.planning/
/.workbuddy/

# ── 回滚兜底资产（2026-10-07 新增：2.8 GB 兜底包 + 解包目录，永不入库）──
