# ═══════════════════════════════════════════════════════════════
#Wealth_Management .gitignore
#
# 原则：
#   1. 能重建的大文件 → 不入库（数据库、产出、第三方代码）
#   2. 研究结论与报告 → 必须入库（results/ 下的 HTML/CSV 是核心资产）
#   3. 任何密钥凭证 → 永不入库
# ═══════════════════════════════════════════════════════════════

# ── 数据层：数据库与行情文件（1.9G，可从通达信重建）──────────
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
raw/

# ── 列式/二进制数据文件 ─────────────────────────────────────
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.pt
*.pth

# ── 运行时产出（可由脚本重新生成，含 68M 中间结果）────────────
# ⚠️ 目录重组：原 09_研究项目/factor_lab/out/ → runtime/
runtime/
out/
output/
reports/generated/

# ── 第三方开源项目（935M，只读参考）────────────────────────
# ⚠️ 目录重组：原 06_开源项目/ → reference/
reference/

# ── 研究产出：只忽略中间 CSV，保留报告与结论 ────────────────
# ⚠️ 原规则是results/（整目录忽略），导致 05_实证研究 下的
#    黄金分割实证研究报告.html / PDF 从未入库 —— 那是核心结论，不能丢
results/**/*.log
results/**/*_raw.txt
*_result.csv
*_detail.csv
cross_validation.csv
cand_fail.csv
cand_success.csv
fib_tdx_cases.csv
# 说明：cases_dated.csv / 因子多前瞻期IC_全市场.csv / 选股能力_全市场实测.csv
#      是研究结论本身，刻意入库，便于他人复核数字

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── 虚拟环境（uv）──────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv / 工具缓存 ─────────────────────────────────────────
.uv/
uv-cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# ── IDE / 系统 ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 密钥与凭证（永不入库）───────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
token.txt
*tushare_token*
